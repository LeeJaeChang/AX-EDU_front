# true면 서버 없이 메모리 목 데이터로 동작
VITE_USE_MOCK=true
# 슈퍼스쿨 환경별 호스트 (예: https://api.superschool.link)
VITE_API_HOST=
# 실제 서버 시연용 고정 계정 토큰 (VITE_USE_MOCK=false일 때만 씀, 비워 두면 '보는 사람' 선택이 숨겨짐)
# 백엔드 저장소에서 `./gradlew demoTokens`로 만든 값. 서버의 AXEDU_JWT_SECRET과 같은 키로 서명돼야 한다.
VITE_DEMO_TOKEN_USR_T1=
VITE_DEMO_TOKEN_USR_P1=
VITE_DEMO_TOKEN_USR_P2=
