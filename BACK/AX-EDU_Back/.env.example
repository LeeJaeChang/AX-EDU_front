# 이 파일을 복사해 .env 로 만들고 값을 채우세요 (.env 는 git 에 올라가지 않습니다)
#   cp .env.example .env
# 서버(./gradlew bootRun, IntelliJ 실행)는 프로젝트 루트의 .env 를 자동으로 읽습니다.

# PostgreSQL 접속 정보
AXEDU_DB_HOST=localhost
AXEDU_DB_PORT=5432
AXEDU_DB_NAME=axedu
AXEDU_DB_USER=
AXEDU_DB_PASSWORD=

# 위 HOST/PORT/NAME 대신 URL 을 통째로 쓰려면 (끝의 ?stringtype=unspecified 는 꼭 붙일 것)
# AXEDU_DB_URL=jdbc:postgresql://localhost:5432/axedu?stringtype=unspecified

# 법령 조회 파이썬 서버 주소 (python3 ai/law_search_server.py, 기본 http://127.0.0.1:8090)
# AXEDU_LAW_SEARCH_URL=http://127.0.0.1:8090

# OpenAI(ChatGPT) API — 민원 키워드 추출. 비워 두면 AI 대신 규칙 기반으로 동작
OPENAI_API_KEY=
# 모델을 바꾸려면 (기본 gpt-4.1-mini)
# AXEDU_OPENAI_MODEL=gpt-4.1-mini

# 시연용 데모 데이터·계정 (배포 서버에서만 의미 있음. 로컬 local 프로필은 항상 켜짐)
# AXEDU_DEMO_ENABLED=true
# AXEDU_DEMO_TOKEN_EXPIRES_AT=2026-12-31T23:59:59+09:00
# 토큰 만들기: ./gradlew demoTokens  (이 파일의 AXEDU_JWT_SECRET 을 씀 → 배포 서버와 같은 값이어야 함)
# AXEDU_JWT_SECRET=
